# Copy this file to .env and fill in local values.
# Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://pujapath:pujapath@localhost:5432/pujapath

# FastAPI
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# OpenAI — backend only. Never expose this to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Object storage (S3-compatible). Leave empty to use local storage in development.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pujapath-media
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

# Frontend (public, non-secret)
VITE_API_URL=/api
VITE_SITE_URL=http://localhost:5173
